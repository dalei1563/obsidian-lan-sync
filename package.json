{
  "name": "obsidian-lan-sync",
  "version": "0.5.0",
  "private": true,
  "description": "Self-hosted Markdown synchronization service and Obsidian desktop plugin",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/test.mjs",
    "server": "node dist/server/cli.cjs start",
    "pair": "node dist/server/cli.cjs pair",
    "backup": "node dist/server/cli.cjs backup",
    "invite": "node dist/server/cli.cjs invite",
    "test:couch": "node scripts/test.mjs --couch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0"
  }
}
